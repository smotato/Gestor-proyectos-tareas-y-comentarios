meta {
  name: Cambiar el rol propio a propietario (200, sin cambios)
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/proyectos/{{proyectoId}}/miembros/{{uid}}
  body: json
  auth: bearer
}

headers {
  Origin: {{baseUrl}}
}

auth:bearer {
  token: {{idToken}}
}

body:json {
  {
    "rol": "propietario"
  }
}

assert {
  res.status: eq 200
  res.body.proyecto.id: isString
}

docs {
  Solo el propietario cambia roles. Un editor o un lector recibiría 403 (hace falta una segunda cuenta para probarlo).
}
