meta {
  name: Iniciar sesión
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/sesion
  body: json
  auth: bearer
}

headers {
  Origin: {{baseUrl}}
}

auth:bearer {
  token: {{idToken}}
}

body:json {
  {
    "idToken": "{{idToken}}"
  }
}

assert {
  res.status: eq 204
}

docs {
  Cambia el idToken por la cookie de sesión. El idToken debe ser reciente (menos de 5 minutos). Se envía también como Authorization: Bearer, que es como se autentican las demás peticiones.
}
