meta {
  name: Cambiar el estado de la tarea
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/api/proyectos/{{proyectoId}}/tareas/{{tareaId}}
  body: json
  auth: bearer
}

headers {
  Origin: {{baseUrl}}
}

auth:bearer {
  token: {{idToken}}
}

body:json {
  {
    "estado": "hecha"
  }
}

assert {
  res.status: eq 200
  res.body.tarea.estado: eq hecha
}

docs {
  Cambiar el estado queda en el registro de actividad.
}
