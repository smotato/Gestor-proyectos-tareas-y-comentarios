meta {
  name: Comentar con texto vacío (400)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/proyectos/{{proyectoId}}/tareas/{{tareaId}}/comentarios
  body: json
  auth: bearer
}

headers {
  Origin: {{baseUrl}}
}

auth:bearer {
  token: {{idToken}}
}

body:json {
  {
    "texto": ""
  }
}

assert {
  res.status: eq 400
  res.body.detalles[0].campo: eq texto
}
