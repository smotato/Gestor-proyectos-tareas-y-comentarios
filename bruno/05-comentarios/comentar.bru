meta {
  name: Comentar una tarea
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/proyectos/{{proyectoId}}/tareas/{{tareaId}}/comentarios
  body: json
  auth: bearer
}

headers {
  Origin: {{baseUrl}}
}

auth:bearer {
  token: {{idToken}}
}

body:json {
  {
    "texto": "Ya subí la maqueta"
  }
}

assert {
  res.status: eq 201
  res.body.comentario.texto: eq Ya subí la maqueta
}

docs {
  El autor sale de la sesión. Un lector recibiría 403.
}
