meta {
  name: Crear proyecto
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/proyectos
  body: json
  auth: bearer
}

headers {
  Origin: {{baseUrl}}
}

auth:bearer {
  token: {{idToken}}
}

body:json {
  {
    "nombre": "Proyecto de Bruno"
  }
}

assert {
  res.status: eq 201
  res.body.proyecto.nombre: eq Proyecto de Bruno
}

script:post-response {
  bru.setEnvVar("proyectoId", res.body.proyecto.id);
}

docs {
  Quien lo crea queda como único propietario. Guarda el id en la variable proyectoId.
}
