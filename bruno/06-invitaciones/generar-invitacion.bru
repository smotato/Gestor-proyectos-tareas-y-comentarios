meta {
  name: Generar una invitación
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/proyectos/{{proyectoId}}/invitaciones
  body: json
  auth: bearer
}

headers {
  Origin: {{baseUrl}}
}

auth:bearer {
  token: {{idToken}}
}

body:json {
  {
    "rol": "lector"
  }
}

assert {
  res.status: eq 201
  res.body.invitacion.usada: eq false
  res.body.invitacion.rol: eq lector
}

script:post-response {
  bru.setEnvVar("codigo", res.body.invitacion.codigo);
}

docs {
  Solo el propietario. Guarda el código en la variable codigo.
}
